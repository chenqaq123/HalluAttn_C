# =============================================================================
# SinkDetect — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust paths for your system. The runners
# (scripts/run.sh, scripts/run_parallel.sh) source this file automatically.

# -----------------------------------------------------------------------------
# Dataset paths (required)
# -----------------------------------------------------------------------------

# COCO val2014 root. Must contain:
#   $COCO_PATH/annotations/instances_val2014.json
#   $COCO_PATH/val2014/COCO_val2014_*.jpg
COCO_PATH=/data/common_dataset/coco-2014-dataset

# -----------------------------------------------------------------------------
# Model paths (required)
# -----------------------------------------------------------------------------

# HF cache root. `from_pretrained("llava-hf/llava-1.5-7b-hf")` will look in
# $HF_HOME/hub/models--llava-hf--llava-1.5-7b-hf/snapshots/<hash>/
HF_HOME=/data/common_model/huggingface

# Model identifier passed to from_pretrained(). Either an HF repo id (preferred
# when HF_HOME is set) or an absolute path that contains config.json directly.
MODEL_PATH=llava-hf/llava-1.5-7b-hf

# -----------------------------------------------------------------------------
# CHAIR cache (required — pickled CHAIR evaluator from the PAS project)
# -----------------------------------------------------------------------------

# Resolved relative to the SinkDetect project root if not absolute.
CHAIR_PKL=../pas/data/chair_coco.pkl

# -----------------------------------------------------------------------------
# Run defaults (optional — uncomment to override per-repo)
# -----------------------------------------------------------------------------

# CUDA_VISIBLE_DEVICES=0,1,2,3
# NUM_SHARDS=4
# NUM_SAMPLES=5000
# MAX_NEW_TOKENS=512
# RATIO=0.5
# START_LAYER=0
# END_LAYER=32
# SEED=42
